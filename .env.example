# --- required ---
PUBLIC_URL=https://os.example.com
# Sign-in: either a password ...
APP_PASSWORD=
# ... or OIDC (Authentik, Authelia, Keycloak, Google). Leave APP_PASSWORD empty to use it.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED=you@example.com

# --- optional defaults (can also be set inside the app: Settings) ---
OWNER_NAME=Anand
IMMICH_URL=
IMMICH_API_KEY=
COOLIFY_URL=
COOLIFY_TOKEN=
# Anands Drive (Cloudreve WebDAV): address ends in /dav, account from Settings > WebDAV
DAV_URL=
DAV_USER=
DAV_PASSWORD=
# Anands Vault (Vaultwarden address only; the master password is never stored)
VAULT_URL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Extra origins the Suite apps may call (comma separated). Empty = same origin only.
CONNECT_SRC_EXTRA=
# Email (Calendar invitations, RSVP replies, booking confirmations). Can also be set in Settings > Email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_DAILY_CAP=200
